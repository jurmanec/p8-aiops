## Slack
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Set to 1 to post. Leave unset (or any other value) to skip posting.
SLACK_POST=
# Signing secret from the Slack app Basic Information page. Set this before the request URL is public.
SLACK_SIGNING_SECRET=

## LLM
XAI_API_KEY=
# Optional. Overrides the default chat model name.
# XAI_MODEL=

## Process (optional)
# PORT=8787
# P8_DB=data/p8.sqlite
# P8_SUMMARY_RUNS=data/summary-runs.jsonl

## Phoenix / evals (optional; see docs/how-to/phoenix-arize.md)
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# PHOENIX_API_KEY=
# PHOENIX_PROJECT=
